    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
