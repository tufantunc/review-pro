{
  "name": "review-pro",
  "version": "0.4.1",
  "description": "Tiered AI code-review installer CLI: install the review-pro core (skills + subagents) into opencode, Claude Code, Cursor, Codex, plus stack packs.",
  "license": "MIT",
  "type": "module",
  "author": "tufantunc (https://github.com/tufantunc)",
  "homepage": "https://github.com/tufantunc/review-pro#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tufantunc/review-pro.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/tufantunc/review-pro/issues"
  },
  "keywords": [
    "code-review",
    "ai",
    "llm",
    "agent",
    "skills",
    "subagents",
    "security",
    "opencode",
    "cursor",
    "claude-code",
    "codex"
  ],
  "bin": {
